{
  "info": {
    "_postman_id": "ridelink-collection-v1",
    "name": "RideLink Microservices API Collection",
    "description": "Comprehensive Postman test collection for the 4 RideLink Spring Boot microservices covering all required workflows and negative scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Account Service (Port 8081)",
      "item": [
        {
          "name": "1.1 Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"adminToken\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ridelink.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{accountUrl}}/api/auth/login",
              "host": ["{{accountUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login as Passenger",
