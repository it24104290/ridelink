        {
          "name": "5.3 Negative: Unauthorized Role Action (Passenger accepting ride) (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
