    {
      "name": "4. Ride Management Service - Complete End-to-End Workflow (Port 8083)",
      "item": [
        {
          "name": "4.1 Passenger Requests Ride (Auto-match Driver & Estimate Fare)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"rideId\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"placeName\": \"Colombo Fort\",\n    \"latitude\": 6.9344,\n    \"longitude\": 79.8428\n  },\n  \"destination\": {\n    \"placeName\": \"Galle Face Green\",\n    \"latitude\": 6.9271,\n    \"longitude\": 79.8440\n  },\n  \"serviceArea\": \"Colombo\",\n  \"autoAssignDriver\": true\n}"
            },
            "url": {
              "raw": "{{rideUrl}}/api/rides",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides"]
            }
          }
        },
        {
          "name": "4.2 Driver Accepts Assigned Ride",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/rides/{{rideId}}/accept",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "accept"]
            }
          }
        },
        {
          "name": "4.3 Driver Starts Ride",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/rides/{{rideId}}/start",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "start"]
            }
          }
        },
        {
          "name": "4.4 Driver Completes Ride",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/rides/{{rideId}}/complete",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "complete"]
            }
          }
        },
        {
          "name": "4.5 Passenger Pays for Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CARD\"\n}"
            },
            "url": {
              "raw": "{{rideUrl}}/api/rides/{{rideId}}/pay",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "pay"]
            }
          }
        },
        {
          "name": "4.6 View Completed Ride Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/rides/{{rideId}}",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides", "{{rideId}}"]
            }
          }
        },
        {
          "name": "4.7 Passenger Ride History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/rides/passenger/me",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides", "passenger", "me"]
            }
          }
        },
        {
          "name": "4.8 Driver Ride History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{rideUrl}}/api/rides/driver/me",
              "host": ["{{rideUrl}}"],
              "path": ["api", "rides", "driver", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Negative & Failure Scenarios",
      "item": [
        {
          "name": "5.1 Negative: Self-Register as ADMIN (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Hacker Admin\",\n  \"email\": \"hacker@attack.local\",\n  \"password\": \"Password123!\",\n  \"phone\": \"0779998877\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
