    {
      "name": "3. Fare & Payment Service (Port 8084)",
      "item": [
        {
          "name": "3.1 Request Fare Estimate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"sample-ride-01\",\n  \"pickup\": {\n    \"placeName\": \"Colombo Fort\",\n    \"latitude\": 6.9344,\n    \"longitude\": 79.8428\n  },\n  \"destination\": {\n    \"placeName\": \"Mount Lavinia Beach\",\n    \"latitude\": 6.8375,\n    \"longitude\": 79.8647\n  }\n}"
            },
            "url": {
              "raw": "{{fareUrl}}/api/fares/estimate",
              "host": ["{{fareUrl}}"],
              "path": ["api", "fares", "estimate"]
            }
          }
        },
        {
          "name": "3.2 Calculate Final Fare",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"sample-ride-01\",\n  \"pickup\": {\n    \"placeName\": \"Colombo Fort\",\n    \"latitude\": 6.9344,\n    \"longitude\": 79.8428\n  },\n  \"destination\": {\n    \"placeName\": \"Mount Lavinia Beach\",\n    \"latitude\": 6.8375,\n    \"longitude\": 79.8647\n  }\n}"
            },
            "url": {
              "raw": "{{fareUrl}}/api/fares/calculate",
              "host": ["{{fareUrl}}"],
              "path": ["api", "fares", "calculate"]
            }
          }
        },
        {
          "name": "3.3 Record Simulated Payment Directly",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"paymentId\", jsonData.paymentId);",
                  "pm.environment.set(\"receiptNumber\", jsonData.receiptNumber);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"direct-test-ride\",\n  \"amount\": 850.50,\n  \"method\": \"CARD\",\n  \"currency\": \"LKR\"\n}"
            },
            "url": {
              "raw": "{{fareUrl}}/api/payments",
              "host": ["{{fareUrl}}"],
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "3.4 Retrieve Payment by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
